+// The caller serializes this with LiStartConnection() and LiStopConnection().
+int LiSendBitrateRequest(uint32_t id, uint32_t kbps) {
+    if (id == 0 || (kbps != 0 && (kbps < 500 || kbps > 150000)) ||
+            !IS_SUNSHINE() || !encryptedControlStream || peer == NULL || ConnectionInterrupted) {
+        return -1;
+    }
+    uint32_t payload[] = { LE32(id), LE32(kbps) };
+    return sendMessageEnet(FLASHLINK_BITRATE_REQUEST, sizeof(payload), payload,
+                           CTRL_CHANNEL_GENERIC, ENET_PACKET_FLAG_RELIABLE, false) ? 0 : -1;
+}
