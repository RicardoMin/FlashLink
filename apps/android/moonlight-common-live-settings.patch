+// The caller serializes this with LiStartConnection() and LiStopConnection().
+static int sendLiveSettingRequest(uint16_t type, uint32_t id, uint32_t value) {
+    if (id == 0 ||
+            !IS_SUNSHINE() || !encryptedControlStream || peer == NULL || ConnectionInterrupted) {
+        return -1;
+    }
+    uint32_t payload[] = { LE32(id), LE32(value) };
+    return sendMessageEnet(type, sizeof(payload), payload,
+                           CTRL_CHANNEL_GENERIC, ENET_PACKET_FLAG_RELIABLE, false) ? 0 : -1;
+}
+
+int LiSendBitrateRequest(uint32_t id, uint32_t kbps) {
+    if (kbps != 0 && (kbps < 500 || kbps > 150000)) return -1;
+    return sendLiveSettingRequest(FLASHLINK_BITRATE_REQUEST, id, kbps);
+}
+
+int LiSendFrameRateRequest(uint32_t id, uint32_t fps) {
+    if (fps > 240) return -1;
+    return sendLiveSettingRequest(FLASHLINK_FPS_REQUEST, id, fps);
+}
