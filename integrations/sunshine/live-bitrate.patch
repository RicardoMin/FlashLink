+  bitrate_result_t apply_live_bitrate(encode_session_t &session, config_t &config, const bitrate_request_t &request) {
+    if (config.configured_bitrate <= 0) {
+      return {request.id, bitrate_status_e::unsupported, 0};
+    }
+    const bool change = request.total_kbps != 0 && request.total_kbps != static_cast<uint32_t>(config.configured_bitrate);
+    const auto status = session.set_video_bitrate(change ? request.video_kbps : 0);
+    if (status == bitrate_status_e::unsupported) {
+      return {request.id, status, 0};
+    }
+    if (change && status == bitrate_status_e::applied) {
+      config.bitrate = request.video_kbps;
+      config.configured_bitrate = static_cast<int>(request.total_kbps);
+      BOOST_LOG(info) << "Applied live bitrate: " << config.configured_bitrate << " Kbps total, " << config.bitrate << " Kbps video";
+    }
+    return {request.id, status, static_cast<uint32_t>(config.configured_bitrate)};
