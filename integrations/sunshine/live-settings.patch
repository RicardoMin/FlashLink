+TEST(LiveFramerateTest, SamplesEachPeerAtItsOwnCadence) {
+  using clock = std::chrono::steady_clock;
+  const auto fastest = std::chrono::nanoseconds(1s) / 120;
+  for (int rate : {30, 60, 90, 120}) {
+    std::optional<clock::time_point> phase;
+    int frames = 0;
+    for (int i = 0; i < 120; ++i) {
+      frames += video::capture_frame_due(phase, clock::time_point {} + fastest * i, std::chrono::nanoseconds(1s) / rate, fastest);
+    }
+    EXPECT_EQ(frames, rate);
+  }
+}
+
+TEST(LiveFramerateTest, UnchangedPeerKeepsItsPhaseWhenSharedCaptureRateToggles) {
+  using clock = std::chrono::steady_clock;
+  const auto tick = std::chrono::nanoseconds(1s) / 120;
+  const auto observer_interval = std::chrono::nanoseconds(1s) / 30;
+  std::optional<clock::time_point> phase;
+  int frames = 0;
+  // The other peer switches every 50 ms. Each new capture pacing group can
+  // produce its first picture immediately, even just after the last group ended.
+  for (int i = 0; i < 120; ++i) {
+    const int capture_ticks = (i / 6) % 2 == 0 ? 2 : 4;
+    if ((i % 6) % capture_ticks == 0) {
+      const auto fastest = capture_ticks == 4 ? observer_interval : std::chrono::nanoseconds(1s) / 60;
+      frames += video::capture_frame_due(phase, clock::time_point {} + i * tick, observer_interval, fastest);
+    }
+  }
+  EXPECT_EQ(frames, 30);
+}
