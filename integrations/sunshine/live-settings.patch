+    auto audioBitrateAdjustment = (audio_config.flags[audio::config_t::HIGH_QUALITY] ? 256 : 96) * audio_config.channels;
+    total_kbps -= std::min((std::int64_t) audioBitrateAdjustment, total_kbps / 5);
