+TEST(LiveBitrateTest, CommitsOnlyChangesAcceptedByTheCurrentEncoder) {
+  struct encoder_t: video::encode_session_t {
+    video::bitrate_status_e status = video::bitrate_status_e::unsupported;
+    std::vector<int> budgets;
+    video::bitrate_status_e set_video_bitrate(int kbps) override {
+      budgets.push_back(kbps);
+      return status;
+    }
+    int convert(platf::img_t &) override { return 0; }
+    void request_idr_frame() override {}
+    void request_normal_frame() override {}
+    void invalidate_ref_frames(int64_t, int64_t) override {}
+  } encoder;
+
+  video::config_t config {};
+  config.configured_bitrate = 8000;
+  config.bitrate = 5708;
+  const auto request = [&](uint32_t total, int video_kbps) {
+    const auto result = video::apply_live_bitrate(encoder, config, {42, total, video_kbps});
+    EXPECT_EQ(42u, result.id);
+    return result;
+  };
+
+  EXPECT_EQ(request(0, 0).status, video::bitrate_status_e::unsupported);
+  encoder.status = video::bitrate_status_e::applied;
+  EXPECT_EQ(request(0, 0).total_kbps, 8000u);
+  EXPECT_EQ(request(24000, 18508).total_kbps, 24000u);
+  EXPECT_EQ(config.bitrate, 18508);
+  EXPECT_EQ(request(24000, 18508).total_kbps, 24000u);  // Retry just queries the encoder.
+  encoder.status = video::bitrate_status_e::failed;
+  auto result = request(8000, 5708);
+  EXPECT_EQ(result.status, video::bitrate_status_e::failed);
+  EXPECT_EQ(result.total_kbps, 24000u);
+  EXPECT_EQ(config.bitrate, 18508);
+  EXPECT_EQ(encoder.budgets, (std::vector<int> {0, 0, 18508, 0, 5708}));
